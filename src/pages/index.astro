---
import Layout from "../layouts/Layout.astro";

const skills = [
  { name: "TypeScript / React", pct: 88, tone: "green", status: "RUNNING", kind: "running" },
  { name: "PostgreSQL", pct: 85, tone: "green", status: "RUNNING", kind: "running" },
  { name: "Python / FastAPI", pct: 85, tone: "green", status: "RUNNING", kind: "running" },
  { name: "Node.js / Express", pct: 80, tone: "green", status: "RUNNING", kind: "running" },
  { name: "Next.js", pct: 78, tone: "green", status: "RUNNING", kind: "running" },
  { name: "LLM APIs / RAG / MCP", pct: 75, tone: "green", status: "RUNNING", kind: "running" },
  { name: "OpenTelemetry / Prometheus", pct: 70, tone: "green", status: "RUNNING", kind: "running" },
  { name: "Supabase", pct: 75, tone: "green", status: "RUNNING", kind: "running" },
  { name: "Docker", pct: 65, tone: "amber", status: "LEARNING", kind: "learning" },
  { name: "Kubernetes", pct: 55, tone: "amber", status: "LEARNING", kind: "learning" },
  { name: "Redis", pct: 55, tone: "gray", status: "STANDBY", kind: "standby" },
  { name: "Flutter", pct: 55, tone: "gray", status: "STANDBY", kind: "standby" },
];

const projects = [
  { id: "agenttrace", name: "AgentTrace", status: "LIVE", kind: "live", stack: "OTel, Prometheus, K8s", detail: "multi-agent tracing" },
  { id: "page-pulse", name: "Page Pulse", status: "LIVE", kind: "live", stack: "TypeScript, Next.js", detail: "28 checks / audit" },
  { id: "jewelry-erp", name: "Jewel-ERP", status: "LIVE", kind: "live", stack: "React 19, TS, IndexedDB", detail: "runs a real shop" },
  { id: "smartcut", name: "SmartCut MCP", status: "LIVE", kind: "live", stack: "Python, MCP", detail: "agent-driven editing" },
  { id: "healthtribe", name: "HealthTribe API", status: "LIVE", kind: "live", stack: "FastAPI, Supabase", detail: "shipped in prod" },
  { id: "wa-bot", name: "WhatsApp Bot", status: "BETA", kind: "beta", stack: "n8n, Flowise", detail: "FAQ + lead capture" },
];
---

<Layout>
  <!-- ── top navigation bar ───────────────────────────── -->
  <header class="topbar">
    <div class="topbar-left">
      <span class="sys-pill"><span class="dot"></span>SYSTEM ONLINE</span>
      <span class="topbar-name">Kaushal Rajput</span>
      <span class="topbar-role">— Full-Stack &amp; AI Engineer</span>
    </div>
    <div class="topbar-right">
      <span class="badge badge-loc">📍 Mumbai, IN</span>
      <span class="badge badge-green">OPEN TO WORK</span>
      <span class="badge badge-blue" id="clock">--:--:-- UTC</span>
    </div>
  </header>

  <div class="shell">
    <!-- ── sidebar ─────────────────────────────────────── -->
    <nav class="sidebar" aria-label="Sections">
      <div class="sidebar-label">~/kaushal</div>
      <a class="nav-link" href="#/overview" data-route-link="overview"><span class="caret">&gt;</span>/overview</a>
      <a class="nav-link" href="#/experience" data-route-link="experience"><span class="caret">&gt;</span>/experience</a>
      <a class="nav-link" href="#/projects" data-route-link="projects"><span class="caret">&gt;</span>/projects</a>
      <a class="nav-link" href="#/skills" data-route-link="skills"><span class="caret">&gt;</span>/skills</a>
      <a class="nav-link" href="#/contact" data-route-link="contact"><span class="caret">&gt;</span>/contact</a>
      <a class="nav-link nav-easter" href="#/logs" data-route-link="logs"><span class="caret">*</span>/logs</a>
      <div class="sidebar-meta">
        env: production<br />
        region: ap-south-1<br />
        build: v2026.6.11
      </div>
    </nav>

    <!-- ── main panel ──────────────────────────────────── -->
    <main class="main">
      <!-- ═══ /overview ═══ -->
      <section class="route" data-route="overview">
        <div class="route-header">
          <div class="route-path">~/kaushal/overview</div>
          <h1 class="route-title">System Overview</h1>
          <p class="route-sub">Primary node: one full-stack engineer, deployed in Mumbai. All services nominal.</p>
        </div>

        <div class="stat-grid">
          <div class="stat-card">
            <div class="stat-value">2<span class="unit">+ yrs</span></div>
            <div class="stat-label">Experience</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">12<span class="unit">+</span></div>
            <div class="stat-label">Projects Deployed</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">5</div>
            <div class="stat-label">Tech Stacks</div>
          </div>
          <div class="stat-card stat-hire">
            <div class="stat-value">✓ AVAILABLE</div>
            <div class="stat-label">For Hire</div>
          </div>
        </div>

        <div class="widget">
          <div class="widget-head">
            <span>runtime config</span>
            <span class="head-tag">// system.config.js</span>
          </div>
          <pre class="codeblock" id="config-code" aria-label="system configuration"><span class="cursor"></span></pre>
        </div>

        <div class="widget">
          <div class="widget-head"><span>description</span><span class="head-tag">README.md</span></div>
          <div class="widget-body" style="font-size:14.5px; line-height:1.75; color:#cbd5e1; max-width:68ch;">
            Full-stack developer who ships. I build APIs, front ends, and the occasional
            ERP that ends up running a real business. Currently full-stack at
            <span class="mono" style="color:var(--accent)">AVMSmiles</span>, working across
            <span class="mono" style="color:var(--accent)">FastAPI</span>,
            <span class="mono" style="color:var(--accent)">Node.js</span> and
            <span class="mono" style="color:var(--accent)">React</span>.
            <br /><br />
            The part I care most about is agentic AI you can actually debug — LLM pipelines
            with distributed tracing, per-hop metrics and trace-linked logs, so a failed agent
            run has a root cause instead of a shrug. If it has a queue, a cron job, a webhook
            or a span — I'm interested.
          </div>
        </div>
      </section>

      <!-- ═══ /experience ═══ -->
      <section class="route" data-route="experience">
        <div class="route-header">
          <div class="route-path">~/kaushal/experience</div>
          <h1 class="route-title">Event Log</h1>
          <p class="route-sub">Chronological record of deployments, incidents, and upgrades to this engineer.</p>
        </div>

        <div class="widget">
          <div class="widget-head"><span>journalctl -u career --no-pager</span><span class="head-tag">7 events</span></div>
          <div class="log-view">
            <div class="log-line"><span class="log-ts">[2024-25]</span> <span class="log-level info">INFO</span> :: <span class="log-msg"><b>Robotics Trainer &amp; Web Developer</b> — Anthony Group of Schools (St. Apollonia's) · taught robotics &amp; programming, built and deployed internal web apps</span></div>
            <div class="log-line"><span class="log-ts">[2024]</span>&nbsp;&nbsp;&nbsp;<span class="log-level warn">WARN</span> :: <span class="log-msg">Deployed <b>Jewel-ERP</b> for a jewellery retailer · solo build, real users, still running the shop</span></div>
            <div class="log-line"><span class="log-ts">[2025-11]</span> <span class="log-level info">INFO</span> :: <span class="log-msg"><b>Backend Developer</b> — HealthTribe · FastAPI + Node, JWT/OTP auth, Supabase schema, shipped to production (6 months)</span></div>
            <div class="log-line"><span class="log-ts">[2026-05]</span> <span class="log-level success">SUCCESS</span> :: <span class="log-msg"><b>Full-Stack Web Developer</b> — AVMSmiles · current role · schema → REST API → React → deploy</span></div>
            <div class="log-line"><span class="log-ts">[2026-07]</span> <span class="log-level info">INFO</span> :: <span class="log-msg">Shipped <b>AgentTrace</b> · multi-agent LLM pipeline on Kubernetes, fully instrumented with OpenTelemetry, Prometheus, Grafana, Loki &amp; Tempo</span></div>
            <div class="log-line"><span class="log-ts">[2026-12]</span> <span class="log-level info">INFO</span> :: <span class="log-msg">Expected: <b>B.Sc. Computer Science</b> — Shankar Narayan College, University of Mumbai</span></div>
            <div class="log-line"><span class="log-ts">[now]</span>&nbsp;&nbsp;&nbsp;&nbsp;<span class="log-level success">SUCCESS</span> :: <span class="log-msg">Status flag set → <b>open_to_work</b> · full-stack, AI &amp; agentic engineering roles</span></div>
          </div>
        </div>
      </section>

      <!-- ═══ /projects ═══ -->
      <section class="route" data-route="projects">
        <div class="route-header">
          <div class="route-path">~/kaushal/projects</div>
          <h1 class="route-title">Active Deployments</h1>
          <p class="route-sub">Click any service row for full deployment details.</p>
        </div>

        <div class="widget">
          <div class="widget-head"><span>services · 6 running</span><span class="head-tag">refresh: live</span></div>
          <div class="proj-table">
            <div class="proj-thead">
              <span>Service Name</span><span>Status</span><span class="col-stack">Stack</span><span>Notes</span><span class="col-link" style="text-align:right">Link</span>
            </div>
            {projects.map((p) => (
              <div class="proj-row" data-project={p.id} role="button" tabindex="0" aria-label={`Open details for ${p.name}`}>
                <span class="proj-name">{p.name}</span>
                <span class={`proj-status ${p.kind}`}><span class={`dot ${p.kind === "beta" ? "dot-amber" : ""}`}></span>{p.status}</span>
                <span class="proj-stack col-stack">{p.stack}</span>
                <span class="proj-uptime">{p.detail}</span>
                <span class="proj-link col-link">[→ View]</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ═══ /skills ═══ -->
      <section class="route" data-route="skills">
        <div class="route-header">
          <div class="route-path">~/kaushal/skills</div>
          <h1 class="route-title">Service Health Monitor</h1>
          <p class="route-sub">Each skill runs as a service. Capacity reflects production confidence, not tutorial hours.</p>
        </div>

        <div class="widget">
          <div class="widget-head"><span>htop --skills</span><span class="head-tag">12 services</span></div>
          <div class="svc-table" id="svc-table">
            {skills.map((s) => (
              <div class="svc-row">
                <span class="svc-name">{s.name}</span>
                <div class="bar"><div class={`bar-fill ${s.tone}`} style={`--pct:${s.pct}%`}></div></div>
                <span class="svc-pct">{s.pct}%</span>
                <span class={`svc-status ${s.kind}`}>
                  <span class={`dot ${s.tone === "amber" ? "dot-amber" : s.tone === "gray" ? "dot-gray" : ""}`}></span>
                  {s.status}
                </span>
              </div>
            ))}
          </div>
          <div class="legend">
            <i style="color:var(--green)">● strong</i>
            <i style="color:var(--amber)">● learning</i>
            <i>● familiar</i>
          </div>
        </div>
      </section>

      <!-- ═══ /contact ═══ -->
      <section class="route" data-route="contact">
        <div class="route-header">
          <div class="route-path">~/kaushal/contact</div>
          <h1 class="route-title">API Reference — Contact</h1>
          <p class="route-sub">One public endpoint. No auth required. Rate limit: be reasonable.</p>
        </div>

        <div class="contact-grid">
          <div class="widget">
            <div class="endpoint-line">
              <span class="method">POST</span>
              <span class="endpoint-path">/api/contact</span>
            </div>
            <pre class="codeblock" is:raw>
<span class="tok-com">// REQUEST BODY</span>
{
  <span class="tok-key">"name"</span>:    <span class="tok-str">"string"</span>,
  <span class="tok-key">"email"</span>:   <span class="tok-str">"string"</span>,
  <span class="tok-key">"message"</span>: <span class="tok-str">"string"</span>
}

<span class="tok-com">// RESPONSE 200</span>
{
  <span class="tok-key">"status"</span>: <span class="tok-str">"message_received"</span>,
  <span class="tok-key">"eta"</span>:    <span class="tok-str">"24h"</span>
}</pre>
          </div>

          <div class="widget">
            <div class="widget-head"><span>request builder</span><span class="head-tag">try it ↓</span></div>
            <form class="api-form" id="contact-form" novalidate>
              <div class="field">
                <label for="f-name">name <span class="req">*</span></label>
                <input id="f-name" name="name" type="text" required placeholder='"Ada Lovelace"' autocomplete="name" />
              </div>
              <div class="field">
                <label for="f-email">email <span class="req">*</span></label>
                <input id="f-email" name="email" type="email" required placeholder='"ada@analytical.engine"' autocomplete="email" />
              </div>
              <div class="field">
                <label for="f-message">message <span class="req">*</span></label>
                <textarea id="f-message" name="message" rows="4" required placeholder='"Let&apos;s build something."'></textarea>
              </div>
              <button class="send-btn" type="submit" id="send-btn">▶ Send Request</button>
            </form>
            <div class="response-block" id="response-block">
              <div class="response-status" id="response-status">HTTP/1.1 200 OK · 142ms</div>
              <pre class="codeblock" id="response-body"></pre>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══ /logs (easter egg) ═══ -->
      <section class="route" data-route="logs">
        <div class="route-header">
          <div class="route-path">~/kaushal/logs</div>
          <h1 class="route-title">tail -f /var/log/kaushal.log</h1>
          <p class="route-sub">You found the logs. This is what actually runs in the background.</p>
        </div>

        <div class="widget">
          <div class="widget-head"><span>live stream</span><span class="head-tag" style="color:var(--green)">● streaming</span></div>
          <div class="term" id="term" aria-live="off"></div>
        </div>
      </section>
    </main>
  </div>

  <!-- ── project drawer ─────────────────────────────────── -->
  <div class="drawer-backdrop" id="drawer-backdrop"></div>
  <aside class="drawer" id="drawer" aria-hidden="true">
    <div class="drawer-head">
      <span style="font-size:12px; color:var(--muted)" id="drawer-path">/projects/—</span>
      <button class="drawer-close" id="drawer-close" type="button">ESC ✕</button>
    </div>
    <div class="drawer-body" id="drawer-body"></div>
  </aside>

  <!-- ── toast ──────────────────────────────────────────── -->
  <div class="toast" id="toast" role="status">✅ 200 OK — Message delivered</div>

  <!-- ── status bar ─────────────────────────────────────── -->
  <footer class="statusbar">
    <span><span class="ok">●</span> all systems operational</span>
    <div class="statusbar-right">
      <span>node v24.x</span>
      <span>mem 512MB</span>
      <span>ap-south-1 (Mumbai)</span>
    </div>
  </footer>

  <script>
    /* ───────── live clock ───────── */
    const clock = document.getElementById("clock")!;
    const tick = () => {
      clock.textContent =
        new Date().toLocaleTimeString("en-GB", { timeZone: "UTC", hour12: false }) + " UTC";
    };
    tick();
    setInterval(tick, 1000);

    /* ───────── hash router ───────── */
    const ROUTES = ["overview", "experience", "projects", "skills", "contact", "logs"];
    const sections = document.querySelectorAll<HTMLElement>("[data-route]");
    const links = document.querySelectorAll<HTMLElement>("[data-route-link]");
    let typedOnce = false;
    let logsTimer: ReturnType<typeof setTimeout> | null = null;

    function activate(route: string) {
      if (!ROUTES.includes(route)) route = "overview";
      sections.forEach((s) => s.classList.toggle("active", s.dataset.route === route));
      links.forEach((l) => l.classList.toggle("active", l.dataset.routeLink === route));
      document.title = `kaushal@portfolio:~/${route}`;

      if (route === "overview" && !typedOnce) { typedOnce = true; typeConfig(); }
      if (route === "skills") {
        const t = document.getElementById("svc-table")!;
        t.classList.remove("animate");
        requestAnimationFrame(() => requestAnimationFrame(() => t.classList.add("animate")));
      }
      if (route === "logs") startLogs();
      else stopLogs();
    }

    const currentRoute = () => location.hash.replace(/^#\/?/, "") || "overview";
    window.addEventListener("hashchange", () => activate(currentRoute()));
    activate(currentRoute());

    /* ───────── typing animation: system.config.js ───────── */
    type Tok = { t: string; c?: string };
    const CONFIG_LINES: Tok[][] = [
      [{ t: "// system.config.js — last deploy: 2026-08-10", c: "tok-com" }],
      [{ t: "module", c: "tok-kw" }, { t: ".exports = {", c: "tok-punc" }],
      [{ t: "  name", c: "tok-key" }, { t: ": ", c: "tok-punc" }, { t: '"Kaushal Rajput"', c: "tok-str" }, { t: ",", c: "tok-punc" }],
      [{ t: "  role", c: "tok-key" }, { t: ": ", c: "tok-punc" }, { t: '"Full-Stack & AI Engineer"', c: "tok-str" }, { t: ",", c: "tok-punc" }],
      [{ t: "  company", c: "tok-key" }, { t: ": ", c: "tok-punc" }, { t: '"AVMSmiles"', c: "tok-str" }, { t: ",", c: "tok-punc" }],
      [{ t: "  stack", c: "tok-key" }, { t: ": [", c: "tok-punc" }, { t: '"React"', c: "tok-str" }, { t: ", ", c: "tok-punc" }, { t: '"Next.js"', c: "tok-str" }, { t: ", ", c: "tok-punc" }, { t: '"FastAPI"', c: "tok-str" }, { t: ", ", c: "tok-punc" }, { t: '"Node.js"', c: "tok-str" }, { t: ", ", c: "tok-punc" }, { t: '"PostgreSQL"', c: "tok-str" }, { t: "],", c: "tok-punc" }],
      [{ t: "  focus", c: "tok-key" }, { t: ": [", c: "tok-punc" }, { t: '"agentic AI"', c: "tok-str" }, { t: ", ", c: "tok-punc" }, { t: '"observability"', c: "tok-str" }, { t: ", ", c: "tok-punc" }, { t: '"MCP"', c: "tok-str" }, { t: "],", c: "tok-punc" }],
      [{ t: "  status", c: "tok-key" }, { t: ": ", c: "tok-punc" }, { t: '"open_to_work"', c: "tok-str" }, { t: ",", c: "tok-punc" }, { t: "  // recruiters: this flag is for you", c: "tok-com" }],
      [{ t: "  location", c: "tok-key" }, { t: ": ", c: "tok-punc" }, { t: '"Mumbai, IN"', c: "tok-str" }, { t: ",", c: "tok-punc" }],
      [{ t: "  caffeine", c: "tok-key" }, { t: ": ", c: "tok-punc" }, { t: '"chai > coffee"', c: "tok-str" }, { t: ",", c: "tok-punc" }],
      [{ t: "};", c: "tok-punc" }],
    ];

    function typeConfig() {
      const pre = document.getElementById("config-code")!;
      const cursor = pre.querySelector(".cursor")!;
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      let li = 0, ti = 0, ci = 0;
      let span: HTMLSpanElement | null = null;

      function step() {
        if (li >= CONFIG_LINES.length) return;
        const line = CONFIG_LINES[li];
        if (ti >= line.length) {
          pre.insertBefore(document.createTextNode("\n"), cursor);
          li++; ti = 0; ci = 0; span = null;
          setTimeout(step, 30);
          return;
        }
        const tok = line[ti];
        if (!span) {
          span = document.createElement("span");
          if (tok.c) span.className = tok.c;
          pre.insertBefore(span, cursor);
        }
        ci++;
        span.textContent = tok.t.slice(0, ci);
        if (ci >= tok.t.length) { ti++; ci = 0; span = null; }
        setTimeout(step, reduced ? 0 : 9 + Math.random() * 18);
      }
      setTimeout(step, 350);
    }

    /* ───────── project drawer ───────── */
    const PROJECTS: Record<string, any> = {
      agenttrace: {
        name: "AgentTrace",
        status: "● LIVE", statusColor: "var(--green)",
        desc: "Full observability stack for a multi-agent LLM pipeline — planner → tool call → FAISS retriever → LLM — deployed on Kubernetes. Every run emits one distributed trace: a span per hop plus a span per tool call including retries, per-hop latency and token usage and tool failure rates as Prometheus metrics, and structured JSON logs stamped with the trace_id. A failed run goes dashboard → trace → logs → root cause in about a minute.",
        kv: { runtime: "FastAPI, 2 replicas", orchestration: "Kubernetes (kind)", traces: "OTel → Tempo", logs: "Promtail → Loki" },
        tags: ["OpenTelemetry", "Prometheus", "Grafana", "Loki", "Tempo", "Kubernetes", "FAISS"],
        links: [{ label: "→ View Code", href: "https://github.com/KAUSHALCODER123/-AgentTrace" }],
      },
      "page-pulse": {
        name: "Page Pulse",
        status: "● LIVE", statusColor: "var(--green)",
        desc: "A URL audit service built to production spec rather than demo spec. One fetch per request, 28 deterministic checks across delivery, SEO, metadata, accessibility and security headers, returning a weighted score plus the evidence behind every verdict. The interesting parts are the timeouts, admission control, response cache, SSRF guard on user-supplied URLs, and the structured error taxonomy.",
        kv: { checks: "28 deterministic", scale: "designed for 10k audits/day", guard: "SSRF + admission control", ci: "GitHub Actions" },
        tags: ["TypeScript", "Next.js", "Node.js", "Vercel", "CI"],
        links: [{ label: "→ View Code", href: "https://github.com/KAUSHALCODER123/-Production-grade-Page-Pulse" }],
      },
      "jewelry-erp": {
        name: "Jewel-ERP",
        status: "● LIVE", statusColor: "var(--green)",
        desc: "Offline-first jewellery retail ERP, built solo and running a real shop. POS with barcode scanning, item master with HUID, customers and KYC, purchases and suppliers, gold savings schemes, Girvi gold loans, Karigar metal tracking, order booking, day book, and full GST — CGST/SGST/IGST, TCS, URD old-gold exchange — with GSTR-1 reporting and CSV export.",
        kv: { storage: "Dexie / IndexedDB", isolation: "multi-firm + RBAC", users: "real, daily", desktop: "Tauri wrap planned" },
        tags: ["React 19", "TypeScript", "Vite", "Tailwind", "Zustand", "React Query", "Zod"],
        links: [{ label: "→ View Code", href: "https://github.com/KAUSHALCODER123/jewllery-erpp" }],
      },
      smartcut: {
        name: "SmartCut MCP",
        status: "● LIVE", statusColor: "var(--green)",
        desc: "A Model Context Protocol server that lets an LLM agent edit real CapCut projects — editing operations exposed as callable tools rather than chat output. Parses the generated subtitle track to detect silences and duplicate takes, then cuts them. Runs fully locally with no API key; an optional LLM path improves duplicate detection while the deterministic heuristic stays the default.",
        kv: { protocol: "MCP", runtime: "Python 3.10+", mode: "local-first, no API key", optional: "LLM-enhanced dedupe" },
        tags: ["MCP", "Python", "Agent Tooling", "Heuristics"],
        links: [{ label: "→ View Code", href: "https://github.com/KAUSHALCODER123/Capcut-claude-editing-ai-tool" }],
      },
      healthtribe: {
        name: "HealthTribe API",
        status: "● LIVE", statusColor: "var(--green)",
        desc: "Production backend for a health & fitness platform. REST endpoints for workout planning, exercise management and notifications; JWT + OTP auth; a relational Supabase schema with foreign-key integrity. Shipped DLT/TRAI-compliant SMS OTP for Indian numbers after diagnosing carrier-level delivery failures.",
        kv: { role: "Backend Developer", tenure: "Nov 2025 – Apr 2026", db: "Supabase (Postgres)", auth: "JWT + OTP (MSG91)" },
        tags: ["FastAPI", "Node.js", "Supabase", "PostgreSQL", "Flutter", "Railway"],
        links: [{ label: "→ GitHub", href: "https://github.com/KAUSHALCODER123" }],
      },
      "wa-bot": {
        name: "WhatsApp Bot",
        status: "◉ BETA", statusColor: "var(--amber)",
        desc: "Conversational automation on WhatsApp using n8n workflows and a Flowise RAG agent. Handles FAQs, lead capture, and handoff to a human when it gets out of its depth (it knows its depth).",
        kv: { stage: "beta", flow: "n8n + Flowise", channel: "WhatsApp Business", retrieval: "RAG" },
        tags: ["n8n", "Flowise", "RAG", "Webhooks", "Automation"],
        links: [{ label: "→ View Code", href: "https://github.com/KAUSHALCODER123/wp-bot" }],
      },
    };

    const drawer = document.getElementById("drawer")!;
    const drawerBody = document.getElementById("drawer-body")!;
    const drawerPath = document.getElementById("drawer-path")!;

    function openDrawer(id: string) {
      const p = PROJECTS[id];
      if (!p) return;
      drawerPath.textContent = `/projects/${id}`;
      drawerBody.innerHTML = `
        <h3>${p.name}</h3>
        <span class="mono" style="font-size:12px; color:${p.statusColor}">${p.status}</span>
        <p class="drawer-desc">${p.desc}</p>
        <dl class="kv">${Object.entries(p.kv).map(([k, v]) => `<dt>${k}</dt><dd>${v}</dd>`).join("")}</dl>
        <div class="tags">${p.tags.map((t: string) => `<span class="tag">${t}</span>`).join("")}</div>
        <div class="drawer-links">${p.links.map((l: any) => `<a class="btn btn-solid" href="${l.href}">${l.label}</a>`).join("")}</div>`;
      document.body.classList.add("drawer-open");
      drawer.setAttribute("aria-hidden", "false");
    }
    function closeDrawer() {
      document.body.classList.remove("drawer-open");
      drawer.setAttribute("aria-hidden", "true");
    }

    document.querySelectorAll<HTMLElement>("[data-project]").forEach((row) => {
      row.addEventListener("click", () => openDrawer(row.dataset.project!));
      row.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); openDrawer(row.dataset.project!); }
      });
    });
    document.getElementById("drawer-close")!.addEventListener("click", closeDrawer);
    document.getElementById("drawer-backdrop")!.addEventListener("click", closeDrawer);
    window.addEventListener("keydown", (e) => { if (e.key === "Escape") closeDrawer(); });

    /* ───────── contact form ───────── */
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const sendBtn = document.getElementById("send-btn") as HTMLButtonElement;
    const respBlock = document.getElementById("response-block")!;
    const respStatus = document.getElementById("response-status")!;
    const respBody = document.getElementById("response-body")!;
    const toast = document.getElementById("toast")!;

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      sendBtn.disabled = true;
      sendBtn.textContent = "⠋ Sending…";
      const ms = 380 + Math.floor(Math.random() * 400);

      setTimeout(() => {
        // TODO: wire to EmailJS / API route — this simulates the 200 for now
        const data = new FormData(form);
        respStatus.textContent = `HTTP/1.1 200 OK · ${ms}ms`;
        respBody.textContent = JSON.stringify(
          { status: "message_received", from: data.get("email"), eta: "24h" },
          null, 2
        );
        respBlock.classList.add("show");
        sendBtn.disabled = false;
        sendBtn.textContent = "▶ Send Request";
        form.reset();
        toast.classList.add("show");
        setTimeout(() => toast.classList.remove("show"), 3200);
      }, ms);
    });

    /* ───────── /logs terminal ───────── */
    const TERM_LINES: { m: string; c: string }[] = [
      { m: "Boot sequence complete. Mounting /dev/motivation…", c: "lvl-info" },
      { m: "Building side projects…", c: "lvl-info" },
      { m: "Drinking chai… ☕", c: "lvl-warn" },
      { m: "Pushing to main (no tests, living dangerously)", c: "lvl-err" },
      { m: 'git commit -m "fix: actually fix the bug this time"', c: "lvl-ok" },
      { m: "Reading Postgres docs for fun. Again.", c: "lvl-dim" },
      { m: "npm install… (this may take a lifetime)", c: "lvl-dim" },
      { m: "Webhook received → it was a health check. It's always a health check.", c: "lvl-info" },
      { m: "Refactoring code nobody asked me to refactor", c: "lvl-warn" },
      { m: 'docker ps → 14 containers, 3 of them mysteries', c: "lvl-info" },
      { m: "Explaining to client why the cloud is not literally a cloud", c: "lvl-dim" },
      { m: "Latency to chai shop: 4ms. Acceptable.", c: "lvl-ok" },
      { m: "TODO found from 2024. Status: still TODO.", c: "lvl-warn" },
      { m: 'SELECT * FROM motivation WHERE day = "Monday" → 0 rows', c: "lvl-err" },
      { m: "Recruiter ping detected. Routing to /contact…", c: "lvl-ok" },
      { m: "All services nominal. Kaushal is online.", c: "lvl-ok" },
    ];

    const term = document.getElementById("term")!;
    let termIdx = 0;

    function pad(n: number) { return String(n).padStart(2, "0"); }
    function pushTermLine() {
      const d = new Date();
      const ts = `[${pad(d.getUTCHours())}:${pad(d.getUTCMinutes())}:${pad(d.getUTCSeconds())}]`;
      const entry = TERM_LINES[termIdx % TERM_LINES.length];
      termIdx++;
      const div = document.createElement("div");
      div.className = `term-line ${entry.c}`;
      div.innerHTML = `<span class="t">${ts}</span> ${entry.m.replace(/&/g, "&amp;").replace(/</g, "&lt;")}`;
      term.appendChild(div);
      while (term.children.length > 60) term.removeChild(term.firstChild!);
      term.scrollTop = term.scrollHeight;
    }

    function startLogs() {
      if (logsTimer) return;
      if (term.children.length === 0) for (let i = 0; i < 5; i++) pushTermLine();
      const loop = () => {
        pushTermLine();
        logsTimer = setTimeout(loop, 700 + Math.random() * 1400);
      };
      logsTimer = setTimeout(loop, 600);
    }
    function stopLogs() {
      if (logsTimer) { clearTimeout(logsTimer); logsTimer = null; }
    }
  </script>
</Layout>
